{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://bevelgraphics.com/shop/reel-director",
      "statusCode": 302,
      "has": [
        {
          "type": "host",
          "value": "reel.bevelgraphics.com"
        }
      ]
    }
  ]
}
