# Copy the field names into your local/deployment environment. Keep real secrets out of git.
SHOP_CHECKOUT_ENABLED=false
SHOP_SITE_URL=http://127.0.0.1:3000
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Use a unique cryptographically random value of at least 32 characters.
SHOP_SESSION_SECRET=

# Seller details displayed in the purchase terms. Required for checkout.
SHOP_SELLER_NAME=
SHOP_SELLER_ADDRESS=

# Stable HTTPS endpoints to the edition ZIPs in private storage, supporting HEAD and GET.
# Never put paid ZIPs under public/. These URLs are used only by the server.
REEL_DIRECTOR_DOWNLOAD_URL=
REEL_DIRECTOR_PRO_DOWNLOAD_URL=
SHOP_DOWNLOAD_BEARER_TOKEN=

# Netlify production: private Blobs storage with streaming through an Edge Function.
# Set the provider to netlify-blobs and configure both versioned release keys.
SHOP_DOWNLOAD_PROVIDER=
REEL_DIRECTOR_BLOB_KEY=
REEL_DIRECTOR_PRO_BLOB_KEY=
